rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Authenticated users are administrators in this console
    function isAdmin() {
      return isAuthenticated();
    }

    // ===============================================================
    // 1. Customer Enquiries Collection (`enquiries`)
    // ===============================================================
    match /enquiries/{enquiryId} {
      // Public visitors can only create new enquiries with valid customer name and phone
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.mobileNumber is string
                    && request.resource.data.mobileNumber.size() >= 10;

      // Only authenticated admins can read, update status, assign, or delete enquiries
      allow read, update, delete: if isAdmin();

      // Subcollection for internal notes locked to authorized admin UIDs
      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ===============================================================
    // 2. Administrator Users (`adminUsers` & `admins`)
    // ===============================================================
    match /adminUsers/{adminId} {
      allow read, write: if isAuthenticated();
    }

    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // 3. Real-Time Website Traffic & Visitor Analytics (`analytics`)
    // ===============================================================
    match /analytics/{docId} {
      // Public visitors record hit counters; admins read dashboard metrics
      allow read, write: if true;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
