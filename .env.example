# Sri Caterers Chennai - Application Configuration

# Set to true when Firebase backend is linked in Phase 2
VITE_USE_FIREBASE=false

# Firebase Public Web Configuration (Phase 2)
# Replace placeholders with your Firebase Web App credentials
VITE_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey
VITE_FIREBASE_AUTH_DOMAIN=sricaterers-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sricaterers-prod
VITE_FIREBASE_STORAGE_BUCKET=sricaterers-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:exampleappid
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Authorized Admin Placeholders (For Phase 2 setup)
# ADMIN_EMAIL_1=admin1@sricaterers.in
# ADMIN_EMAIL_2=admin2@sricaterers.in
# ADMIN_EMAIL_3=admin3@sricaterers.in
